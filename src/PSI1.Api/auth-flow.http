@PSI1.Api_HostAddress = http://localhost:5158

### 1. Register a new user
# Change the email/username if you've already run this once (both are unique).
POST {{PSI1.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "flowtest@gmail.com",
  "username": "flowtest",
  "password": "testpass123"
}

### 2. Register with the same email again -> expect 409 Conflict
POST {{PSI1.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "flowtest@gmail.com",
  "username": "someoneelse",
  "password": "testpass123"
}

### 3. Register with the same username again -> expect 409 Conflict
POST {{PSI1.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "someoneelse@gmail.com",
  "username": "flowtest",
  "password": "testpass123"
}

### 4. Log in -> stash the token into the global "token" variable

# @name login
POST {{PSI1.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "flowtest@gmail.com",
  "password": "testpass123"
}
###
@token = {{login.response.body.$.token}}

### 5. Log in with the wrong password -> expect 401
POST {{PSI1.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "flowtest@gmail.com",
  "password": "wrongpassword"
}

### 6. List available languages (anonymous, no token needed) -> expect 200 + JSON array
GET {{PSI1.Api_HostAddress}}/api/languages

### 7. Select a language WITHOUT a token -> expect 401 Unauthorized
PUT {{PSI1.Api_HostAddress}}/api/languages/select
Content-Type: application/json

{
  "language": "Lithuanian"
}

### 8. Select a language WITH an invalid/garbage token -> expect 401 Unauthorized
PUT {{PSI1.Api_HostAddress}}/api/languages/select
Content-Type: application/json
Authorization: Bearer this.is.not.a.valid.jwt

{
  "language": "Lithuanian"
}

### 9. Select a language WITH the token from step 4 -> expect 200 + JSON object
# Requires running request #4 first in the same session so {{token}} is populated.
PUT {{PSI1.Api_HostAddress}}/api/languages/select
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "language": "Russian"
}

### 10. Confirm the change by selecting a different language -> expect 200, language: "English"
PUT {{PSI1.Api_HostAddress}}/api/languages/select
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "language": "English"
}

### 11. integer form

PUT {{PSI1.Api_HostAddress}}/api/languages/select
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "language": 2
}

###-------------------------------------------
### 27. Register first category test user
POST {{PSI1.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "categorytest1@gmail.com",
  "username": "categorytest1",
  "password": "testpass123"
}

### 28. Register second category test user
POST {{PSI1.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "categorytest2@gmail.com",
  "username": "categorytest2",
  "password": "testpass123"
}

### 29. Log in as first category test user

# @name loginCatUser1
POST {{PSI1.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "categorytest1@gmail.com",
  "password": "testpass123"
}
###
@catToken1 = {{loginCatUser1.response.body.$.token}}

### 30. Log in as second category test user

# @name loginCatUser2
POST {{PSI1.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "categorytest2@gmail.com",
  "password": "testpass123"
}
###
@catToken2 = {{loginCatUser2.response.body.$.token}}

### 31. List available categories (anonymous, no token needed) -> expect 200 + JSON array
GET {{PSI1.Api_HostAddress}}/api/categories

### 32. Select a category WITHOUT a token -> expect 401 Unauthorized
PUT {{PSI1.Api_HostAddress}}/api/categories/select
Content-Type: application/json

{
  "category": "Nature"
}

### 33. Select Nature for first user
PUT {{PSI1.Api_HostAddress}}/api/categories/select
Content-Type: application/json
Authorization: Bearer {{catToken1}}

{
  "category": "Nature"
}

### 34. Select Food for second user
PUT {{PSI1.Api_HostAddress}}/api/categories/select
Content-Type: application/json
Authorization: Bearer {{catToken2}}

{
  "category": "Food"
}

### 35. Change first user's category to Travel
PUT {{PSI1.Api_HostAddress}}/api/categories/select
Content-Type: application/json
Authorization: Bearer {{catToken1}}

{
  "category": "Travel"
}

### 36. Check second user's category -> expect Food
# changing one user's category does not affect another user.
GET {{PSI1.Api_HostAddress}}/api/categories/selected
Authorization: Bearer {{catToken2}}

### 37. Check first user's saved category -> expect Travel
# selected category is persisted and returned by GET.
GET {{PSI1.Api_HostAddress}}/api/categories/selected
Authorization: Bearer {{catToken1}}

### 38. Change first user's category from Travel to Sports
PUT {{PSI1.Api_HostAddress}}/api/categories/select
Content-Type: application/json
Authorization: Bearer {{catToken1}}

{
  "category": "Sports"
}

### 39. Check first user's category again -> expect Sports
# new category replaces the previous selection.
GET {{PSI1.Api_HostAddress}}/api/categories/selected
Authorization: Bearer {{catToken1}}

### 40. Register user without selecting a category
POST {{PSI1.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "categorytest3@gmail.com",
  "username": "categorytest3",
  "password": "testpass123"
}

### 41. Log in as user without a selected category

# @name loginCatUser3
POST {{PSI1.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "categorytest3@gmail.com",
  "password": "testpass123"
}
###
@catToken3 = {{loginCatUser3.response.body.$.token}}

### 42. Get selected category when none was selected -> expect 200 and category: null
GET {{PSI1.Api_HostAddress}}/api/categories/selected
Authorization: Bearer {{catToken3}}

### 43. Get selected category WITHOUT Authorization -> expect 401 Unauthorized
GET {{PSI1.Api_HostAddress}}/api/categories/selected